                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    }
                ],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "photo",
                            "type": "file",
                            "src": ""
                        }
                    ]
                },
                "url": {
                    "raw": "{{base_url}}/api/user/profile/photo",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "user",
                        "profile",
                        "photo"
                    ]
                }
            }
        },
        {
