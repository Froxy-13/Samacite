{
  "info": {
    "_postman_id": "samacite-auth-phase1",
    "name": "SamaCité - Phase 1 Auth API",
    "description": "Collection complète pour tester l'API d'authentification - Phase 1\n\n✅ 30 tests automatisés\n🔐 Authentification Sanctum\n👥 Gestion des rôles et permissions\n\nVérifiez que votre serveur Laravel est démarré sur http://localhost:8000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "🔐 Authentification",
      "item": [
        {
          "name": "1️⃣ Register - Succès",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code est 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Réponse a la structure correcte', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success', true);",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "    pm.expect(jsonData.data).to.have.property('id');",
                  "    pm.expect(jsonData.data).to.have.property('nom');",
                  "    pm.expect(jsonData.data).to.have.property('email');",
                  "    pm.expect(jsonData.data).to.have.property('telephone');",
                  "});",
                  "",
                  "// Sauvegarder l'ID utilisateur",
                  "var userData = pm.response.json().data;",
                  "pm.collectionVariables.set('last_user_id', userData.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nom\": \"Dupont\",\n    \"prenom\": \"Jean\",\n    \"email\": \"jean.dupont@example.com\",\n    \"telephone\": \"+221701234567\",\n    \"password\": \"Password123\",\n    \"password_confirmation\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/register",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Créer un nouvel utilisateur avec email et téléphone"
          },
          "response": []
        },
        {
          "name": "2️⃣ Register - Erreur de validation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code est 422', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test('Erreurs de validation présentes', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.equal(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nom\": \"\",\n    \"prenom\": \"\",\n    \"email\": \"invalid-email\",\n    \"telephone\": \"\",\n    \"password\": \"123\",\n    \"password_confirmation\": \"456\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/register",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Tester la validation des données d'entrée"
          },
          "response": []
        },
        {
          "name": "3️⃣ Register - Email en doublon",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code est 422', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test('Erreur email en doublon', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.equal(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nom\": \"Dupont\",\n    \"prenom\": \"Jean\",\n    \"email\": \"jean.dupont@example.com\",\n    \"telephone\": \"+221709876543\",\n    \"password\": \"Password123\",\n    \"password_confirmation\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/register",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Essayer de créer un utilisateur avec un email existant"
          },
          "response": []
        },
        {
          "name": "4️⃣ Login - Avec email",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code est 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Réponse contient token et utilisateur', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.equal(true);",
                  "    pm.expect(jsonData.data).to.have.property('user');",
                  "    pm.expect(jsonData.data).to.have.property('token');",
                  "});",
                  "",
                  "// Sauvegarder le token pour les requêtes authentifiées",
                  "var token = pm.response.json().data.token;",
                  "pm.collectionVariables.set('auth_token', token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"jean.dupont@example.com\",\n    \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/login",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Se connecter avec un email et un mot de passe"
          },
          "response": []
        },
        {
          "name": "5️⃣ Login - Avec téléphone",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code est 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Token et utilisateur retournés', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.equal(true);",
                  "    pm.expect(jsonData.data.token).to.be.a('string');",
                  "    pm.expect(jsonData.data.user.telephone).to.equal('+221701234567');",
                  "});",
                  "",
                  "// Sauvegarder le token pour téléphone",
                  "var token = pm.response.json().data.token;",
                  "pm.collectionVariables.set('auth_token_phone', token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"phone\": \"+221701234567\",\n    \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/login",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Se connecter avec un numéro de téléphone et un mot de passe"
          },
          "response": []
        },
        {
          "name": "6️⃣ Login - Identifiants invalides",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code est 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Message d\\'erreur approprié', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.equal(false);",
                  "    pm.expect(jsonData.message).to.include('Invalid credentials');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"jean.dupont@example.com\",\n    \"password\": \"WrongPassword123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/login",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Essayer de se connecter avec un mot de passe incorrect"
          },
          "response": []
        },
        {
          "name": "7️⃣ Get Current User (Me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code est 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Données utilisateur retournées', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.equal(true);",
                  "    pm.expect(jsonData.data).to.have.property('id');",
                  "    pm.expect(jsonData.data).to.have.property('nom');",
                  "    pm.expect(jsonData.data).to.have.property('prenom');",
                  "    pm.expect(jsonData.data).to.have.property('roles');",
                  "    pm.expect(jsonData.data).to.have.property('permissions');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/auth/me",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Récupérer les données de l'utilisateur actuellement connecté"
          },
          "response": []
        },
        {
          "name": "8️⃣ Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code est 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Déconnexion réussie', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.equal(true);",
                  "    pm.expect(jsonData.message).to.include('logged out');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/auth/logout",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Se déconnecter et révoquer le token"
          },
          "response": []
        },
        {
          "name": "9️⃣ Unauthorized Request (Pas de token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code est 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/auth/me",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Essayer d'accéder à une ressource protégée sans token"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "auth_token_phone",
      "value": "",
      "type": "string"
    },
    {
      "key": "last_user_id",
      "value": "",
      "type": "string"
    }
  ]
}
